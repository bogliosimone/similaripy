{
  "uid": "similaripy-server",
  "title": "similaripy-server",
  "tags": [
    "similaripy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 13,
      "type": "table",
      "title": "Instances: version and model served",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "similaripy_server_info",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true
            },
            "renameByName": {}
          }
        }
      ],
      "description": "similaripy_server_info{version, model}: during a rolling update, which pod serves which model.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Threads",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 3
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "similaripy_server_threads",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Block size (0 = one block)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 3
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "similaripy_server_block_size",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Items",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 3
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "similaripy_server_items",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Active items",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 3
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "similaripy_server_active_items",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Requests/s per proto",
      "description": "Handled requests (edge 400s included), from the request_seconds histogram count.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (proto) (rate(similaripy_server_request_seconds_count[$__rate_interval]))",
          "legendFormat": "{{proto}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "CPU per request",
      "description": "Whole-process CPU (HTTP, JSON/gRPC, compute, syscalls) over handled requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(process_cpu_seconds_total[$__rate_interval])) / sum(rate(similaripy_server_request_seconds_count[$__rate_interval]))",
          "legendFormat": "process CPU / request",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Request latency (handler)",
      "description": "JSON parsed -> computed -> serialized; gRPC computed -> answer copied. Queue wait, HTTP reads and tonic decode/encode are outside. Red line: the 10 ms budget. Quantiles are interpolated inside buckets (10 us .. 100 ms).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, proto) (rate(similaripy_server_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{proto}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, proto) (rate(similaripy_server_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{proto}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, proto) (rate(similaripy_server_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{proto}}",
          "refId": "C"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Compute latency (Worker::recommend)",
      "description": "Worker::recommend alone. Red line: the 10 ms budget. Quantiles interpolate inside the buckets: all under 10 us reads as p50 5 us, p95 9.5 us.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, proto) (rate(similaripy_server_compute_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{proto}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, proto) (rate(similaripy_server_compute_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{proto}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, proto) (rate(similaripy_server_compute_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{proto}}",
          "refId": "C"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Rejected and truncated (share of requests)",
      "description": "Bad requests over handled requests (edge 400s included); worker errors and truncated histories over requests the worker computed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(similaripy_server_bad_requests_total[$__rate_interval])) / sum(rate(similaripy_server_request_seconds_count[$__rate_interval]))",
          "legendFormat": "bad requests (edge 400)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(similaripy_server_errors_total[$__rate_interval])) / sum(rate(similaripy_server_requests_total[$__rate_interval]))",
          "legendFormat": "worker errors (weights)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(similaripy_server_truncated_total[$__rate_interval])) / sum(rate(similaripy_server_requests_total[$__rate_interval]))",
          "legendFormat": "truncated histories",
          "refId": "C"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Unknown history ids (share)",
      "description": "History ids (after the max_history cut) the model doesn't have: ignored. High = stale model or id mismatch.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - rate(similaripy_server_known_ids_total[$__rate_interval]) / rate(similaripy_server_history_ids_total[$__rate_interval])",
          "legendFormat": "unknown ids",
          "refId": "A"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Requests/s per view",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(similaripy_server_view_requests_total[$__rate_interval])",
          "legendFormat": "{{view}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(similaripy_server_requests_total[$__rate_interval])) - sum(rate(similaripy_server_view_requests_total[$__rate_interval]))",
          "legendFormat": "whole model",
          "refId": "B"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Requests/s per thread (round-robin balance)",
      "description": "Requests each Worker computed. Even lines = balanced connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(similaripy_server_requests_total[$__rate_interval])",
          "legendFormat": "thread {{thread}}",
          "refId": "A"
        }
      ],
      "id": 12
    }
  ]
}
